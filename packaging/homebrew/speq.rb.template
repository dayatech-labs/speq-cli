class Speq < Formula
  desc "Work on product specs with Git commands, through the Speq API"
  homepage "https://github.com/dayatech-labs/speq-cli"
  version "@VERSION@"

  # speq runs Git; macOS has it (Command Line Tools), Linux gets Homebrew's.
  uses_from_macos "git"

  on_macos do
    on_arm do
      url "@MACOS_ARM_URL@"
      sha256 "@MACOS_ARM_SHA256@"
    end
    on_intel do
      url "@MACOS_INTEL_URL@"
      sha256 "@MACOS_INTEL_SHA256@"
    end
  end

  on_linux do
    on_intel do
      url "@LINUX_URL@"
      sha256 "@LINUX_SHA256@"
    end
  end

  def install
    bin.install "speq"
    # Git runs speq under these names: the remote helper for `speq::` URLs, and the credential helper.
    bin.install_symlink "speq" => "git-remote-speq"
    bin.install_symlink "speq" => "git-credential-speq"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/speq --version")
  end
end
