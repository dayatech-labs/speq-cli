{
  "version": "@VERSION@",
  "description": "Work on product specs with Git commands, through the Speq API",
  "homepage": "https://github.com/dayatech-labs/speq-cli",
  "license": "Proprietary",
  "architecture": {
    "64bit": {
      "url": "@WINDOWS_URL@",
      "hash": "@WINDOWS_SHA256@"
    }
  },
  "bin": ["speq.exe", "git-remote-speq.exe", "git-credential-speq.exe"],
  "suggest": { "Git": "git" },
  "checkver": { "github": "https://github.com/dayatech-labs/speq-cli" },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/dayatech-labs/speq-cli/releases/download/v$version/speq-$version-x86_64-pc-windows-msvc.zip"
      }
    }
  }
}
