# Single-file WinGet manifest (schema 1.9 singleton). Submit it with `wingetcreate` or a PR to microsoft/winget-pkgs.
PackageIdentifier: Dayatech.Speq
PackageVersion: "@VERSION@"
PackageLocale: en-US
Publisher: Dayatech
PackageName: Speq
License: Proprietary
ShortDescription: Work on product specs with Git commands, through the Speq API
Installers:
  - Architecture: x64
    InstallerType: zip
    NestedInstallerType: portable
    NestedInstallerFiles:
      - RelativeFilePath: speq.exe
        PortableCommandAlias: speq
      - RelativeFilePath: git-remote-speq.exe
        PortableCommandAlias: git-remote-speq
      - RelativeFilePath: git-credential-speq.exe
        PortableCommandAlias: git-credential-speq
    Dependencies:
      PackageDependencies:
        - PackageIdentifier: Git.Git
    InstallerUrl: @WINDOWS_URL@
    InstallerSha256: @WINDOWS_SHA256@
ManifestType: singleton
ManifestVersion: 1.9.0
